{
  "name": "rescript-ic10-compiler",
  "sources": [
    {
      "dir": "src",
      "subdirs": true
    },
    {
      "dir": "scripts",
      "subdirs": true
    }
  ],
  "package-specs": [
    {
      "module": "commonjs",
      "in-source": true
    }
  ],
  "suffix": ".res.js",
  "dependencies": ["@rescript/core", "sury"],
  "compiler-flags": ["-open RescriptCore", "-open IC10"],
  "ppx-flags": ["sury-ppx/bin"],
  "gentypeconfig": {
    "language": "typescript",
    "shims": {},
    "debug": {
      "all": false
    }
  }
}
