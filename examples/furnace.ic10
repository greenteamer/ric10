define furnaceType HASH("StructureAdvancedFurnace")
define furnaceName HASH("Furnace")
define lcdType HASH("StructureConsoleLED5")
define lcd2Name HASH("FurnaceLCD2")
define dialType HASH("StructureLogicDial")
define dialTempName HASH("FurnaceDialTemp")
define dialPressName HASH("FurnaceDialPress")
define valveType HASH("StructureDigitalValve")
define tankValveName HASH("FurnaceTankValve")
define atmValveName HASH("FurnaceAtmValve")
move r0 0
while0:
lbn r1 furnaceType furnaceName Temperature Maximum
lbn r2 furnaceType furnaceName Pressure Maximum
l r3 d2 Temperature
l r4 d4 Temperature
l r5 d0 Open
l r6 d1 Open
lbn r7 dialType dialTempName Setting Maximum
mul r7 r7 100
lbn r8 dialType dialPressName Setting Maximum
mul r8 r8 1000
sle r9 r2 55000
select r0 r9 r0 3
sne r9 r5 1
select r0 r9 r0 3
sbn lcdType lcd2Name Setting r3
bne r0 3 case5
bnez r5 else6
move r0 0
j endswitch4
else6:
bne r6 1 endswitch4
jal openAtmValveCmd
jal depressurizeCmd
j endswitch4
case5:
bnez r0 case9
sbn furnaceType furnaceName SettingInput 0
sbn furnaceType furnaceName SettingOutput 0
sbn valveType tankValveName On 0
sbn valveType atmValveName On 0
s d3 On 0
bne r5 1 else10
move r0 3
j endswitch4
else10:
ble r2 r8 else12
sle r0 r1 r7
select r0 r0 2 0
j endswitch4
else12:
move r0 1
j endswitch4
case9:
bne r0 1 case16
ble r2 r8 else17
move r0 0
j endswitch4
else17:
ble r3 r7 else19
jal openAtmValveCmd
jal pressurizeCmd
j endswitch4
else19:
ble r4 r7 else21
jal openTankValveCmd
jal pressurizeCmd
j endswitch4
else21:
move r0 0
j endswitch4
case16:
bge r2 r8 else24
move r0 0
j endswitch4
else24:
ble r1 r4 else26
jal openTankValveCmd
jal depressurizeCmd
j endswitch4
else26:
jal openAtmValveCmd
jal depressurizeCmd
endswitch4:
yield
j while0
openAtmValveCmd:
sbn valveType tankValveName On 0
sbn valveType atmValveName On 1
s d3 On 1
j ra
depressurizeCmd:
sbn furnaceType furnaceName SettingInput 0
sbn furnaceType furnaceName SettingOutput 10
s d3 Mode 0
j ra
pressurizeCmd:
sbn furnaceType furnaceName SettingInput 10
sbn furnaceType furnaceName SettingOutput 0
s d3 Mode 1
j ra
openTankValveCmd:
sbn valveType tankValveName On 1
sbn valveType atmValveName On 0
s d3 On 0
j ra
