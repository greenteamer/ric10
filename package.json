{
  "name": "rescript-ic10-compiler",
  "description": "ReScript to IC10 compiler for Stationeers",
  "version": "0.1.5",
  "bin": {
    "ric10": "./bin/ric10.js"
  },
  "files": [
    "bin/",
    "dist/",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "res:clean": "rescript clean",
    "res:build": "rescript",
    "res:dev": "rescript watch",
    "compile": "node dist/compile.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "build:bundle": "npm run build:compile && npm run build:init",
    "build:compile": "esbuild scripts/compile.res.mjs --bundle --platform=node --outfile=dist/compile.js --format=cjs --external:fs --external:path",
    "build:init": "esbuild scripts/init.res.mjs --bundle --platform=node --outfile=dist/init.js --format=cjs --external:fs --external:path",
    "prepublishOnly": "npm run res:build && npm run build:bundle"
  },
  "devDependencies": {
    "@rescript/language-server": "^1.66.0",
    "@types/node": "^18.0.0",
    "esbuild": "^0.27.2",
    "jest": "^30.2.0",
    "rescript": "^12.1.0"
  },
  "jest": {
    "roots": [
      "<rootDir>/tests"
    ],
    "testMatch": [
      "**/*.test.mjs"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.claude/"
    ],
    "transform": {}
  }
}
